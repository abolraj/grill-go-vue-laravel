    "components": {
        "schemas": {
            "Food": {
                "required": [
                    "name",
                    "price",
                    "number"
                ],
                "properties": {
                    "id": {
                        "description": "Food ID",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "description": "Name of the food item",
                        "type": "string",
                        "example": "Pizza"
                    },
                    "price": {
                        "description": "Price of the food item",
                        "type": "number",
                        "format": "float",
                        "example": 9.99
                    },
                    "number": {
                        "description": "Quantity available",
                        "type": "integer",
                        "example": 50
                    },
                    "parent_id": {
                        "description": "ID of the parent food item",
                        "type": "integer",
                        "example": 0
                    }
                },
                "type": "object"
            },
            "Order": {
                "required": [
                    "total_number",
                    "total_price",
                    "status",
                    "duration",
                    "customer_id",
                    "food_id"
                ],
                "properties": {
                    "id": {
                        "description": "Order ID",
                        "type": "integer",
                        "example": 1
                    },
                    "total_number": {
                        "description": "Total number of items",
                        "type": "integer",
                        "example": 3
                    },
                    "total_price": {
                        "description": "Total price of the order",
                        "type": "number",
                        "format": "float",
                        "example": 29.99
                    },
                    "status": {
                        "description": "Order status",
                        "type": "string",
                        "example": "pending"
                    },
                    "duration": {
                        "description": "Duration in minutes",
                        "type": "integer",
                        "example": 30
                    },
                    "customer_id": {
                        "description": "ID of the customer who placed the order",
                        "type": "integer",
                        "example": 1
                    },
                    "food_id": {
                        "description": "ID of the food item ordered",
                        "type": "integer",
                        "example": 2
                    }
                },
                "type": "object"
            },
            "User": {
                "required": [
                    "name",
                    "username",
                    "email",
                    "password"
                ],
                "properties": {
                    "id": {
                        "description": "User ID",
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "description": "Name of the user",
                        "type": "string",
                        "example": "John Doe"
                    },
                    "username": {
                        "description": "Username",
                        "type": "string",
                        "example": "johndoe"
                    },
                    "email": {
                        "description": "Email address",
                        "type": "string",
                        "format": "email",
                        "example": "johndoe@example.com"
                    },
                    "location": {
                        "description": "Location of the user",
                        "type": "string",
                        "example": "New York, USA"
                    },
                    "password": {
                        "description": "Password",
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "email_verified_at": {
                        "description": "Email verified at",
                        "type": "string",
                        "format": "date-time",
                        "example": "2023-01-01T00:00:00Z"
                    },
                    "remember_token": {
                        "description": "Remember token",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Laravel Sanctum",
                "scheme": "bearer"
            }
        }
    },
