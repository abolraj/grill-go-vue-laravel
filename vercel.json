{
    "version": 2,
    "outputDirectory": "back-end/public",
    "builds": [
        { "src": "/back-end/public/index.php", "use": "vercel-php@0.7.3" },
        { "src": "/back-end/public/**", "use": "@vercel/static" }
    ],

    "routes" : [
        {
            "src": "/(.*)",
            "dest": "/back-end/public/index.php"
        }
    ],
    "env": {
        "APP_NAME": "GrillGO",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://grill-go-vue-laravel.vercel.app/",
        "APP_HTTPS":"true",
        "VERCEL_DEMO_MODE": "true",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "array",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "SSR_TEMP_PATH": "/tmp/ssr",
        "NODE_PATH": "node"
    }
}